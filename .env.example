# Copy to .env and edit. Never commit .env (it is in .gitignore).

# --- Azure scope ---------------------------------------------------------------
# Comma-separated subscription IDs to scan. Leave blank to scan every subscription you can see.
AZURE_SUBSCRIPTION_IDS=

# --- Sign-in -------------------------------------------------------------------
# azcli (default): the user is whoever ran `az login`. entra: Microsoft Entra ID sign-in. off: no identity (tests/demos).
AUTH_MODE=azcli
# Role used in azcli/off mode: Viewer, Builder, Approver or Admin.
DEV_ROLE=Admin
# Only for AUTH_MODE=entra:
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# PUBLIC_URL=https://hub.example.com

# --- Demo ----------------------------------------------------------------------
# 1 = built-in sample data, no Azure calls.
MARKETPLACE_DEMO=0

# --- Behaviour (optional) --------------------------------------------------------
# CACHE_TTL=300
# CORP_DOMAINS=example.com
# EVAL_PASS_RATE=80
# RISK_ENFORCE=0
# NL_FEATURES=1
